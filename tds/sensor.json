{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://saref.etsi.org/core/",
      "s4bldg": "https://saref.etsi.org/saref4bldg/"
    }
  ],
  "@type": "saref:TemperatureSensor",
  "id": "urn:dev:room1-sensor",
  "title": "room1-sensor",
  "securityDefinitions": {
    "nosec": {
      "scheme": "nosec"
    }
  },
  "security": "nosec",
  "properties": {
    "temperature": {
      "@type": "saref:Temperature",
      "type": "number",
      "unit": "degC",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://localhost:1883/building/room1/temp",
          "op": [
            "readproperty",
            "observeproperty"
          ]
        }
      ]
    },
    "humidity": {
      "@type": "saref:Humidity",
      "type": "number",
      "unit": "%",
      "readOnly": true,
      "observable": true,
      "forms": [
        {
          "href": "mqtt://localhost:1883/building/room1/humidity",
          "op": [
            "readproperty",
            "observeproperty"
          ]
        }
      ]
    }
  },
  "events": {
    "overheat": {
      "data": {
        "type": "number",
        "unit": "degC"
      },
      "forms": [
        {
          "href": "mqtt://localhost:1883/building/room1/overheat",
          "op": "subscribeevent"
        }
      ]
    }
  },
  "s4bldg:isContained": {
    "@id": "urn:building:room1"
  }
}
