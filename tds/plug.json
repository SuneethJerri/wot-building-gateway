{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://saref.etsi.org/core/",
      "s4bldg": "https://saref.etsi.org/saref4bldg/"
    }
  ],
  "@type": [
    "s4bldg:Outlet",
    "saref:Switch",
    "saref:Meter"
  ],
  "id": "urn:dev:room1-plug",
  "title": "room1-plug",
  "securityDefinitions": {
    "nosec": {
      "scheme": "nosec"
    }
  },
  "security": "nosec",
  "properties": {
    "status": {
      "@type": "saref:OnOffState",
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        },
        "power": {
          "@type": "saref:Power",
          "type": "number",
          "unit": "W"
        }
      },
      "readOnly": true,
      "forms": [
        {
          "href": "http://localhost:8081/status",
          "op": "readproperty"
        }
      ]
    }
  },
  "actions": {
    "switchOn": {
      "@type": "saref:OnCommand",
      "output": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          },
          "power": {
            "@type": "saref:Power",
            "type": "number",
            "unit": "W"
          }
        }
      },
      "forms": [
        {
          "href": "http://localhost:8081/on",
          "op": "invokeaction",
          "htv:methodName": "POST"
        }
      ]
    },
    "switchOff": {
      "@type": "saref:OffCommand",
      "output": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          },
          "power": {
            "@type": "saref:Power",
            "type": "number",
            "unit": "W"
          }
        }
      },
      "forms": [
        {
          "href": "http://localhost:8081/off",
          "op": "invokeaction",
          "htv:methodName": "POST"
        }
      ]
    }
  },
  "s4bldg:isContained": {
    "@id": "urn:building:room1"
  }
}
