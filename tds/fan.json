{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://saref.etsi.org/core/",
      "s4bldg": "https://saref.etsi.org/saref4bldg/"
    }
  ],
  "@type": [
    "s4bldg:Fan",
    "saref:Actuator"
  ],
  "id": "urn:dev:room1-fan-coap-mqtt",
  "title": "room1-fan",
  "securityDefinitions": {
    "nosec": {
      "scheme": "nosec"
    }
  },
  "security": "nosec",
  "properties": {
    "status": {
      "@type": "saref:OnOffState",
      "type": "object",
      "properties": {
        "on": {
          "type": "boolean"
        }
      },
      "readOnly": true,
      "forms": [
        {
          "href": "coap://localhost:5683/status",
          "op": "readproperty",
          "contentType": "application/json"
        },
        {
          "href": "mqtt://localhost:1883/building/room1/fan/status",
          "op": [
            "readproperty",
            "observeproperty"
          ]
        }
      ]
    }
  },
  "actions": {
    "switchOn": {
      "@type": "saref:OnCommand",
      "forms": [
        {
          "href": "coap://localhost:5683/on",
          "op": "invokeaction",
          "cov:method": "PUT"
        },
        {
          "href": "mqtt://localhost:1883/building/room1/fan/cmd",
          "op": "invokeaction"
        }
      ]
    },
    "switchOff": {
      "@type": "saref:OffCommand",
      "forms": [
        {
          "href": "coap://localhost:5683/off",
          "op": "invokeaction",
          "cov:method": "PUT"
        },
        {
          "href": "mqtt://localhost:1883/building/room1/fan/cmd",
          "op": "invokeaction"
        }
      ]
    }
  },
  "s4bldg:isContained": {
    "@id": "urn:building:room1"
  }
}
